// category: Електрика
// title: Мережа 230 В
// blurb: Опір навантаження, потужність і струм під задану потужність.
let u = 230.0;
let amps = 1.6;
print("опір {:.1f} Ом", u / amps);
print("потужність {:.0f} Вт", u * amps);
let wanted = 1200.0;
print("струм на {:.0f} Вт: {:.2f} А", wanted, wanted / u);
