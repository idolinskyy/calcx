// category: Розрахунки
// title: Розкласти партію
// blurb: Якими рівними коробками можна спакувати 360 штук.
let items = 360;
print("партія {} шт.", items);
for (let size = 1; size <= items; ++size) {
  if (items % size == 0) {
    let boxes = int(items / size);
    if (boxes <= 12) {
      print("{} коробок по {} шт.", boxes, size);
    }
  }
}
