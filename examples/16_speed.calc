// category: Побут
// title: Швидкість і гальмівний шлях
// blurb: Км/год у м/с і шлях рівномірного гальмування до зупинки.
fun kmh_to_ms(v) {
  return v * 1000 / 3600;
}
let kmh = 90;
let t = 4;
let v = kmh_to_ms(kmh);
print("{} км/год = {:.2f} м/с", kmh, v);
print("уповільнення {:.2f} м/с²", v / t);
print("шлях {:.1f} м", v * t / 2);
