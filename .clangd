# Конфігурація clangd (використовуйте clangd-22 — див. .vscode/settings.json).
# База компіляції: build/compile_commands.json (генерує CMake).

CompileFlags:
  Add: [-std=c++23]
  Remove: [-std=c++20, -std=gnu++20, -std=c++17, -std=gnu++17]
  Compiler: clang++

Diagnostics:
  UnusedIncludes: None

Index:
  Background: Build

---
# Тести: doctest лежить у build/_deps (FetchContent). Якщо compile_commands
# тимчасово порожній/застарілий — цей fallback прибирає pp_file_not_found.
If:
  PathMatch: tests/.*
CompileFlags:
  Add:
    - -Iinclude
    - -Ibuild/_deps/doctest-src
    - -std=c++23
